; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-9679077125515046~1102427040"
general/ios/app_id="ca-app-pub-9679077125515046~9324356980"

[application]

config/name="Snow Tracks"
config/name_localized={
"de": "Spuren im Schnee",
"en": "Snow Tracks",
"es": "Huellas en la Nieve",
"fr": "Traces dans la Neige",
"pt": "Pegadas na Neve"
}
config/description="Puzzle de lógica: descobre o caminho de cada animal na neve."
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Pegadas na Neve"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.906, 0.937, 0.965, 1)
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/globals.gd"
Sfx="*res://scripts/sfx.gd"
Ads="*res://scripts/ads.gd"
GodotIapPlugin="*res://addons/godot-iap/godot_iap.gd"
Store="*res://scripts/store.gd"
Review="*res://scripts/review.gd"
Reminder="*res://scripts/reminder.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GMPShared/menu/plugin.cfg", "res://addons/InappReviewPlugin/plugin.cfg", "res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/godot-iap/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[internationalization]

locale/translations=PackedStringArray("res://data/traducoes.pt.translation", "res://data/traducoes.en.translation", "res://data/traducoes.es.translation", "res://data/traducoes.fr.translation", "res://data/traducoes.de.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
