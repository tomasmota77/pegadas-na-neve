; Engine configuration file.

config_version=5

[application]

config/name="Snow Tracks"
config/use_custom_user_dir=true
config/custom_user_dir_name="Pegadas na Neve"
config/name_localized={
"de": "Spuren im Schnee",
"en": "Snow Tracks",
"es": "Huellas en la Nieve",
"fr": "Traces dans la Neige",
"pt": "Pegadas na Neve"
}
config/description="Puzzle de lógica: descobre o caminho de cada animal na neve."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.906, 0.937, 0.965, 1)
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/globals.gd"
Sfx="*res://scripts/sfx.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[internationalization]

locale/translations=PackedStringArray("res://data/traducoes.pt.translation", "res://data/traducoes.en.translation", "res://data/traducoes.es.translation", "res://data/traducoes.fr.translation", "res://data/traducoes.de.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
